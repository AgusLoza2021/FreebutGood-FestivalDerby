# Unity generated
/[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db

# Telemetria bajada del celular (Tools/pull-analytics.ps1).
# Son datos de playtest: pesados, efimeros, y con ids de dispositivo. No van al repo.
/AnalyticsData/

# APKs generados por Ninja/Build.
/Builds/

# Capturas de Tools/resume-stress.ps1: logcat, bugreports y tombstones del device.
# Decenas de MB por corrida, efimeras, y con datos del telefono. Se regeneran corriendo
# el script de nuevo.
/Tools/resume-runs/

# Cloudflare Worker del ingestor de analytics (Tools/AnalyticsIngest)
# .dev.vars tiene los tokens de desarrollo local; .wrangler/ es estado de miniflare.
.dev.vars
.wrangler/

# Cache del build nativo (ninja/IL2CPP). Se regenera solo en cada build de Android
# y ensuciaba cada commit con cientos de archivos de fingerprint y compile_commands.
/.utmp/

# Generado por el paquete Entities al buildear subscenes. Cache derivado, se rehace
# solo. Vive bajo Assets/ solo porque DOTS lo pone ahi, no es un asset autorado.
/Assets/SceneDependencyCache/
/Assets/SceneDependencyCache.meta

# Artefacto de deploy del dashboard (se regenera con build.mjs + cp)
Tools/AnalyticsDashboard/dist/

# Capturas y reportes de profiling en device (SurfaceFlinger --timestats, dumps del
# RuntimeProfiler, JSONs de render por frame). Son evidencia de UNA sesion de medicion
# en UN telefono: 1.1 MB que no se releen desde otra maquina y que cada corrida
# reescribe. Las CONCLUSIONES viven en Engram y en Documentation/, que es lo que
# sobrevive; los .txt/.json crudos se quedan locales.
/Profiling/

# ── LMHPOLY / Low Poly Nature Bundle (paquete pago del Asset Store) ──────────
# 21.315 assets, 659 MB, y el juego usa 136 (3,3 MB) = 0,51 %. Medido con el
# cierre transitivo por GUID desde el arte propio (Tools/verify-lmhpoly-closure.ps1).
#
# Por que NO va entero: la historia de git es append-only. Meterlo llevaria .git de
# 726 MB a ~1,4 GB PARA SIEMPRE, y sacarlo despues exige filter-repo/BFG + force
# push, que invalida todos los clones. Git LFS tampoco sirve: el free tier son 1 GB
# de storage y 1 GB/mes de bandwidth, y cada clone lo quema.
#
# Lo que SI va: el cierre transitivo, para que un clone limpio compile y corra sin
# referencias faltantes. Lo que NO va se re-descarga del Asset Store (las compras
# quedan disponibles) y solo hace falta para re-correr BiomeArtSetup > Scan Sources,
# que rankea las 363 rocas del paquete para auto-elegir fuentes.
#
# ⚠ El repo es PRIVADO. Si se hace PUBLICO, esto tiene que salir: redistribuir
# assets pagos viola la EULA del Asset Store.
#
# ⚠ MODO DE FALLA SILENCIOSO: si agregas un asset nuevo del paquete a un bioma, no
# entra solo — queda untracked y otra maquina lo ve como malla faltante. Corre
# Tools/verify-lmhpoly-closure.ps1 antes de una release.
/Assets/LMHPOLY/**
# Re-incluir los DIRECTORIOS: git no puede re-incluir un archivo si su carpeta
# esta excluida, asi que primero hay que dejarlo entrar a las carpetas.
!/Assets/LMHPOLY/**/
